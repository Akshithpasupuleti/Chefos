{
  "name": "chefos-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "APP_VARIANT=user expo start",
    "start:user": "APP_VARIANT=user expo start",
    "start:chef": "APP_VARIANT=chef expo start",
    "build:apk": "APP_VARIANT=user eas build --platform android --profile preview",
    "build:apk:chef": "APP_VARIANT=chef eas build --platform android --profile preview",
    "build:aab": "APP_VARIANT=user eas build --platform android --profile production",
    "android": "APP_VARIANT=user expo run:android",
    "android:user": "APP_VARIANT=user expo run:android",
    "android:chef": "APP_VARIANT=chef expo run:android",
    "ios": "APP_VARIANT=user expo run:ios",
    "ios:user": "APP_VARIANT=user expo run:ios",
    "ios:chef": "APP_VARIANT=chef expo run:ios",
    "web": "expo start --web"
  },
  "dependencies": {
    "@expo/metro-runtime": "~5.0.5",
    "@expo/vector-icons": "^14.1.0",
    "@react-native-async-storage/async-storage": "2.1.2",
    "@react-navigation/bottom-tabs": "^7.3.10",
    "@react-navigation/native": "^7.1.17",
    "@react-navigation/native-stack": "^7.3.21",
    "axios": "^1.13.4",
    "expo": "^53.0.0",
    "expo-constants": "~17.1.6",
    "expo-font": "~13.3.2",
    "expo-linear-gradient": "~14.1.5",
    "expo-location": "~18.1.6",
    "expo-status-bar": "~2.2.3",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-native": "0.79.6",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1",
    "react-native-web": "^0.20.0"
  },
  "devDependencies": {
    "@react-native-community/cli": "latest"
  },
  "engines": {
    "node": ">=18"
  }
}
